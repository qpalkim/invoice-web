# 이 프로젝트 배포/로컬 개발에 필요한 환경 변수 목록입니다.
# 실제 값은 이 파일을 .env.local로 복사한 뒤 채워 넣으세요(.env.local은 git에 커밋되지 않습니다).
# 각 키의 검증 스키마는 src/lib/env.ts를 참고하세요.

# 배포된 앱의 공개 URL. 공유 링크(/q/[shareToken]) 등 절대 URL 생성이 필요할 때 사용합니다.
# 로컬 개발에서는 비워두어도 됩니다. Vercel에 배포하면 VERCEL_URL이 자동 주입되므로 별도 설정 없이도 동작합니다.
NEXT_PUBLIC_APP_URL=

# Supabase 프로젝트 URL과 anon(공개) 키. 브라우저/서버 클라이언트(src/lib/supabase/) 생성에 사용됩니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase 서비스 롤 키(RLS 우회, 서버 전용). 절대 브라우저에 노출되거나 NEXT_PUBLIC_ 접두사를 붙이지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# 노션 API 통합(Integration) 토큰. https://www.notion.so/my-integrations 에서 발급합니다.
NOTION_API_KEY=

# 견적서 데이터베이스의 노션 데이터베이스 ID(URL의 32자리 값).
NOTION_DATABASE_ID=
